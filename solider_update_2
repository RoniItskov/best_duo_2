import pygame

import consts

solider_img = pygame.image.load(r"C:\Users\jbt\Downloads\soldier.png").convert_alpha()
row, column = (0, 0)

def set_solider_pos(row, column):
    solider_pos = (row, column)
    return solider_pos

def lower_part():
    lower_list = []
    for i in range (consts.SOLDIER_COLS):
        lower_list[i] = ( row + consts.SOLDIER_BODY_ROWS, i + column )
    return lower_list

def upper_part():
    upper_list = []
    upper_current_row = []
    for i in range (consts.SOLDIER_BODY_ROWS):
        for j in range (consts.SOLDIER_COLS):
            upper_current_row.append((row + i , column + j))
        upper_list[i] = upper_current_row
    return upper_list

def is_pos_down_valid():
    pos_x = row + 1
    if pos_x <= consts.BOARD_ROWS:
        set_solider_pos(pos_x, column)
        return True
    else:
        return False

def is_pos_up_valid():
    pos_x = row - 1
    if pos_x >= 0:
        set_solider_pos(pos_x, column)
        return True
    else:
        return False

def is_pos_left_valid():
    pos_y = column - 1
    if pos_y >= 0:
        set_solider_pos(row , pos_y)
        return True
    else:
        return False

def is_pos_right_valid():
    pos_y = column + 1
    if pos_y <= consts.BOARD_COLS:
        set_solider_pos(row , pos_y)
        return True
    else:
        return False




