import pygame

pygame.init()

# create display surface
screen = pygame.display.set_mode((800, 600))
pygame.display.set_caption("screen display check")


# load image
solider = pygame.image.load(r"C:\Users\jbt\Downloads\soldier.png").convert_alpha()

# resize images
img_small = pygame.transform.scale(solider, (100, 100))

running = True
while running:
    # fill background
    screen.fill((0, 255, 0))

    # display images at different positions
    screen.blit(img_small, (0, 0))

    # update display
    pygame.display.flip()

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

pygame.quit()
